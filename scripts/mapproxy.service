[Unit]
Description=MapProxy Server Service
After=network.target

[Service]
# Modify User/Group as needed
# User=www-data
# Group=www-data

# Set working directory to project root
WorkingDirectory=/opt/MapproxyServer

# Use the system python to launch the main script
# The script handles virtualenv creation and usage internally
ExecStart=/usr/bin/python3 /opt/MapproxyServer/main.py --service --port 8080 --host 0.0.0.0 --work-dir /opt/MapproxyServer

# Restart configuration
Restart=always
RestartSec=5

# Logging
StandardOutput=append:/var/log/mapproxy.log
StandardError=append:/var/log/mapproxy.error.log

[Install]
WantedBy=multi-user.target
